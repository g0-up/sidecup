# Copy thành .env rồi điền giá trị thật. Không commit .env.
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://sidecup:sidecup@localhost:5432/sidecup?sslmode=disable
APP_TZ=Asia/Ho_Chi_Minh
# Gốc URL công khai: dùng để tạo link QR (/t/<token>), link đơn trong tin Zalo và kiểm tra Origin của WebSocket.
PUBLIC_BASE_URL=http://localhost:5173
# MD5 hex (32 ký tự thường) của mật khẩu người bán. Mật khẩu phải >= 16 ký tự ngẫu nhiên (xem docs/runbook.md).
#   printf '%s' 'mat-khau-cua-ban' | md5sum
SELLER_PASSWORD_HASH=00000000000000000000000000000000
# >= 32 byte ngẫu nhiên:  openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes-xxxxxxxx
# Bearer token cho dịch vụ notifier Zalo gọi /internal/*:  openssl rand -hex 32
NOTIFIER_TOKEN=replace-with-random-token
# Khoá mã hoá phiên Zalo (>= 32 byte):  openssl rand -base64 48
# Bỏ trống thì tắt tính năng gửi trạng thái đơn qua Zalo. Đổi key = phiên cũ hết hạn, phải quét lại QR.
ZALO_CREDENTIAL_KEY=
# Chỉ dùng ở dev khi web không đi qua proxy của Vite. Phân tách bằng dấu phẩy.
CORS_ORIGINS=
LOG_LEVEL=info
MIGRATE_ON_START=true
# Integration test (go test -tags integration) tạo database riêng cho từng package từ URL này.
TEST_DATABASE_URL=postgres://sidecup:sidecup@localhost:5432/sidecup_test?sslmode=disable
