# Biến build-time của Vite (nhúng vào bundle, KHÔNG đặt bí mật ở đây).
# Tên người bán hiện ở chân trang khách và trên thẻ QR in.
VITE_SELLER_NAME=Anh Tùng
# Gốc URL API khi API ở hostname khác web (homelab). Bỏ trống = cùng origin (dev, VPS).
# VITE_API_ORIGIN=https://sidecup-api.cauchuyenlaptrinh.com
# Gốc URL public của web, dùng cho og:url, og:image và canonical. Bỏ trống = không chèn các thẻ đó (dev, E2E).
# VITE_PUBLIC_ORIGIN=https://sidecup.cauchuyenlaptrinh.com
# Chỉ dev: 1 = dùng MSW giả lập API khi chưa chạy apps/api.
VITE_USE_MOCK=0
# Chỉ dev: địa chỉ API mà Vite proxy tới (mặc định http://localhost:8080).
# VITE_API_PROXY=http://localhost:8080
