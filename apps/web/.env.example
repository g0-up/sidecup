# Biến build-time của Vite (nhúng vào bundle, KHÔNG đặt bí mật ở đây).
# Tên người bán hiện ở chân trang khách và trên thẻ QR in.
VITE_SELLER_NAME=Anh Tùng
# Chỉ dev: 1 = dùng MSW giả lập API khi chưa chạy apps/api.
VITE_USE_MOCK=0
# Chỉ dev: địa chỉ API mà Vite proxy tới (mặc định http://localhost:8080).
# VITE_API_PROXY=http://localhost:8080
