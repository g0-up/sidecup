# Copy thành infra/.env trên VPS (hoặc máy homelab) rồi điền giá trị thật. Không commit infra/.env.
# Hostname public. Homelab: overlay ghi cứng hostname, vẫn đặt DOMAIN=sidecup.cauchuyenlaptrinh.com.
DOMAIN=goinuoc.example.vn
# Bắt buộc: email đăng ký chứng chỉ Let's Encrypt. Homelab không dùng nhưng vẫn phải có giá trị.
ACME_EMAIL=admin@example.vn
# Tên người bán hiện ở chân trang khách và thẻ QR (nhúng lúc build web).
SELLER_NAME=Tên người bán

POSTGRES_DB=sidecup
POSTGRES_USER=sidecup
# openssl rand -hex 24
POSTGRES_PASSWORD=

APP_TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info
# MD5 hex của mật khẩu người bán (>= 16 ký tự ngẫu nhiên). Xem docs/runbook.md mục "Mật khẩu người bán".
SELLER_PASSWORD_HASH=
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -hex 32 — dịch vụ notifier dùng làm Bearer token khi gọi /internal/*
NOTIFIER_TOKEN=
# Khoá mã hoá phiên Zalo gửi trạng thái đơn cho khách (>= 32 byte): openssl rand -base64 48
# Bỏ trống thì tắt tính năng. Đổi key = phiên cũ hết hạn, phải quét lại QR trong Cài đặt.
ZALO_CREDENTIAL_KEY=
# Kho ảnh món trên Cloudflare R2 (xem docs/runbook.md mục "Kho ảnh món"). Để trống cả năm biến đầu thì tắt
# tải ảnh lên; đặt thiếu biến nào thì API không khởi động. Chỉ điền khoá thật trong .env, không commit.
R2_ACCOUNT_ID=
# API token R2 quyền Object Read & Write, chỉ cho bucket này.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom domain công khai của bucket (https), ví dụ https://img.example.vn
R2_PUBLIC_BASE_URL=
# Thư mục chứa ảnh trong bucket; bỏ trống thì dùng "products".
R2_FOLDER=sidecup/products
